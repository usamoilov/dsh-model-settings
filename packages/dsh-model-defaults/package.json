{
  "name": "dsh-model-defaults",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH Web settings page: one default model for every profile, DeepSeek off switch, web search provider and subagent model",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "default-model",
    "settings"
  ],
  "license": "MIT",
  "author": "usamoilov",
  "homepage": "https://github.com/usamoilov/dsh-model-settings#readme",
  "bugs": {
    "url": "https://github.com/usamoilov/dsh-model-settings/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usamoilov/dsh-model-settings.git",
    "directory": "packages/dsh-model-defaults"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node test/unit.test.mjs && node test/modules.test.mjs && node test/client.test.mjs && node test/live.test.mjs"
  }
}
